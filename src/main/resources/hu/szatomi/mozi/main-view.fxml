<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.*?>

<VBox alignment="CENTER" spacing="20.0" xmlns="http://javafx.com/javafx/17.0.2-ea" xmlns:fx="http://javafx.com/fxml/1" fx:controller="hu.szatomi.mozi.MainController">
    <padding>
        <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
    </padding>
   <children>
      <HBox prefHeight="400.0" prefWidth="800.0">
         <children>
            <VBox alignment="TOP_CENTER" prefHeight="200.0" prefWidth="300.0" spacing="20.0">
               <children>
                  <Label text="CineManage">
                     <font>
                        <Font name="System Bold" size="24.0" />
                     </font>
                  </Label>
                  <ComboBox fx:id="hallChoice" prefWidth="260.0" promptText="Terem" />
                  <VBox alignment="CENTER_LEFT" prefHeight="100.0" prefWidth="300.0" spacing="10.0">
                     <children>
                        <Label text="Vászon típusa">
                           <VBox.margin>
                              <Insets />
                           </VBox.margin>
                           <font>
                              <Font size="14.0" />
                           </font>
                        </Label>
                        <CheckBox fx:id="checkBox2D" mnemonicParsing="false" text="2D" />
                        <CheckBox fx:id="checkBox3D" layoutX="142.0" layoutY="52.0" mnemonicParsing="false" text="3D" />
                        <CheckBox fx:id="checkBoxIMAX" layoutX="142.0" layoutY="60.0" mnemonicParsing="false" text="IMAX" />
                     </children>
                  </VBox>
                  <VBox spacing="10.0">
                     <children>
                        <VBox prefWidth="100.0">
                           <children>
                              <Label text="Legnépszerűbb">
                                 <font>
                                    <Font name="System Bold" size="14.0" />
                                 </font>
                              </Label>
                              <Label fx:id="maximumLabel" layoutX="10.0" layoutY="10.0" text="Nigga: A felkelés" />
                           </children>
                        </VBox>
                        <VBox prefWidth="100.0">
                           <children>
                              <Label text="Legkisebb nézettségű">
                                 <font>
                                    <Font name="System Bold" size="14.0" />
                                 </font>
                              </Label>
                              <Label fx:id="minimumLabel" layoutX="10.0" layoutY="10.0" text="Nigga: A felkelés" />
                           </children>
                        </VBox>
                     </children>
                  </VBox>
                  <Label fx:id="incomeLabel" text="Bevétel: 67 Ft">
                     <font>
                        <Font name="System Bold" size="18.0" />
                     </font>
                  </Label>
                  <Button fx:id="reportButton" mnemonicParsing="false" prefWidth="100.0" text="Jelentés írása" />
               </children></VBox>
            <ListView fx:id="resultList" prefHeight="200.0" prefWidth="500.0" />
         </children>
      </HBox>
   </children>
</VBox>
